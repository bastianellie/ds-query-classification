# Copy this file to `.env` and fill in your own values.
# Variables are read by LiteLLM (and the optional LITELLM_API_BASE override).
# See https://docs.litellm.ai/docs/providers for the keys each provider expects.

# --- Example: Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Optional: route all requests through a custom LiteLLM/OpenAI-compatible gateway.
LITELLM_API_BASE=

# Optional: custom CA bundle, if your network requires one.
# SSL_CERT_FILE=

# --- Cerebus / Portkey gateway ---
# Minimal setup (matches other internal tools): set DEFAULT_LLM_PROVIDER=cerebus
# below, optionally CEREBUS_API_KEY too, and nothing else — the gateway mode
# ("direct"), the gateway URL, and everything else default to values that work
# out of the box. classify.py/experiment.py also accept --cerebus as an
# equivalent, per-invocation alternative to setting DEFAULT_LLM_PROVIDER.
DEFAULT_LLM_PROVIDER=cerebus

# API key resolution: (1) CEREBUS_API_KEY below, if set; (2) AWS Secrets
# Manager (requires the `cerebus` extra: pip install -e '.[cerebus]', and an
# active SSO session: aws sso login --profile kd-nonprod). Never persisted to
# disk — resolved fresh (and cached in-process) each run.
CEREBUS_API_KEY=

# --- Advanced: only needed to override the defaults above ---
# CEREBUS_MODE=direct        # or "azure" — see README's Cerebus section
# CEREBUS_GATEWAY_AZURE_URL=
# CEREBUS_GATEWAY_DIRECT_URL=
# CEREBUS_CONFIG_ID=         # required only when CEREBUS_MODE=azure
# CEREBUS_AWS_PROFILE=kd-nonprod
# CEREBUS_AWS_REGION=us-east-1
# CEREBUS_SECRET_ID=shared_genai/portkey-nonprod
# CEREBUS_SECRET_KEY=sciencedirect_portkey_api_key
