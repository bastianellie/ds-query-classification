# Copy this file to `.env` and fill in your own values.
# Variables are read by LiteLLM (and the optional LITELLM_API_BASE override).
# See https://docs.litellm.ai/docs/providers for the keys each provider expects.

# --- Example: Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Optional: route all requests through a custom LiteLLM/OpenAI-compatible gateway.
LITELLM_API_BASE=

# Optional: custom CA bundle, if your network requires one.
# SSL_CERT_FILE=

# --- Cerebus / Portkey gateway (opt-in via --cerebus on classify.py/experiment.py) ---
# "azure"  = Azure-backed model, addressed by a Portkey Config ID (CEREBUS_CONFIG_ID).
# "direct" = directly-hosted model (OpenAI, Gemini, ...), addressed via --model's
#            own value (an @workspace/model slug or similar) sent as-is.
CEREBUS_MODE=
CEREBUS_GATEWAY_AZURE_URL=
CEREBUS_GATEWAY_DIRECT_URL=
CEREBUS_CONFIG_ID=

# API key resolution: (1) CEREBUS_API_KEY below, if set; (2) AWS Secrets
# Manager, via the profile/region/secret coordinates below (requires the
# `cerebus` extra: pip install -e '.[cerebus]', and an active SSO session:
# aws sso login --profile <CEREBUS_AWS_PROFILE>). Never persisted to disk —
# resolved fresh (and cached in-process) each run.
CEREBUS_API_KEY=
# CEREBUS_AWS_PROFILE=kd-nonprod
# CEREBUS_AWS_REGION=us-east-1
# CEREBUS_SECRET_ID=shared_genai/portkey-nonprod
# CEREBUS_SECRET_KEY=sciencedirect_portkey_api_key
